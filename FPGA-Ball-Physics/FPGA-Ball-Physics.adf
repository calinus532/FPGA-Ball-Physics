[Project]
Current Flow=Generic
VCS=0
version=4
Current Config=compile
[Configurations]
compile=FPGA-Ball-Physics
[Library]
FPGA-Ball-Physics=.\FPGA-Ball-Physics\FPGA-Ball-Physics.lib
[$LibMap$]
FPGA-Ball-Physics=.
Active_lib=
[Settings]
FLOW_TYPE=HDL
LANGUAGE=VERILOG
REFRESH_FLOW=1
FLOWTOOLS=NONE
FAMILY=
AddGeneratedFilesToDesignBrowser=0
DesignStatusPath=$dsn\src\DESIGN_STATUS
DesignActivationScript=$dsn\design.do
WireDelay=2
fileopenfolder=D:\FPGA-Ball-Physics\FPGA-Ball-Physics\src\testbench
DisableIEEEWarnings=0
AccessACCB=1
AccessACCR=1
AccessReadTopLevel=0
AccessRead=1
AccessReadWrite=0
AccessReadWriteSLP=0
SimulationAccessReadPaths=
SimulationAccessReadModules=
SimulationAccessReadWritePaths=
SimulationAccessReadWriteModules=
SimulationAccessNetsPaths=
SimulationAccessNetsModules=
[HierarchyViewer]
HierarchyInformation=
ShowHide=ShowTopLevel
Selected=
[DesignStructure]
BlockDiagram=.\src
VHDLSourceCode=.\src
SystemVerilogSourceCode=.\src
VerilogSourceCode=.\src
ExternalFile=.\src
