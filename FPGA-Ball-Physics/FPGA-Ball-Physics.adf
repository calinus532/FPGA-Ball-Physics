WarningPrnLevel=1
OptimizationLevel=2
ProtectLevel=0
Strict=1
VerilogNoSpecify=0
EnableDebug=0
ErrorOutputLimit=0
MonitoringOfEventsUDP=1
InitialRegsValue=X
HasInitialRegsValue=0
EnableSLP=1
SlpReuseModelEnable=0
RandomNumberGeneratorSeedType=Default
RandomNumberGeneratorValueSeed=1
